{
  "version": "generation-rag-seed-v1",
  "description": "基于当前 6 首种子诗词的生成层评估骨架。样本用 required_facts、forbidden_facts 和 expected_citations 做确定性判定，覆盖有证据回答、引用完整性和四类拒答；不包含 LLM-as-judge 或人工忠实度评分。",
  "cases": [
    {
      "id": "gen-jingyesi-moon-homesickness",
      "category": "moon_homesickness",
      "question": "请结合诗句说明《静夜思》里明月和思乡的关系。",
      "expected": "answer",
      "required_facts": [
        {
          "id": "moon",
          "any_of": ["明月"]
        },
        {
          "id": "homesickness",
          "any_of": ["思乡", "故乡"]
        }
      ],
      "forbidden_facts": [
        {
          "id": "wrong-author",
          "any_of": ["杜甫"]
        }
      ],
      "expected_citations": [
        {
          "poem_title": "静夜思"
        }
      ]
    },
    {
      "id": "gen-jingyesi-quote-emotion",
      "category": "emotion",
      "question": "“举头望明月，低头思故乡”表达了什么情感？",
      "expected": "answer",
      "required_facts": [
        {
          "id": "homesickness",
          "any_of": ["思乡", "故乡", "怀念家乡"]
        }
      ],
      "forbidden_facts": [
        {
          "id": "wrong-author",
          "any_of": ["杜甫"]
        }
      ],
      "expected_citations": [
        {
          "poem_title": "静夜思"
        }
      ]
    },
    {
